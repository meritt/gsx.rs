{
  "name": "@meritt/gsx-wasm",
  "version": "0.1.2",
  "description": "The gsx/1 markup language in WebAssembly: parsing, diagnostics and projections for social platforms",
  "keywords": [
    "gsx",
    "markdown",
    "markup",
    "parser",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "author": {
    "name": "Alexey Simonenko",
    "email": "alexey@simonenko.dev",
    "url": "https://simonenko.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meritt/gsx.rs.git",
    "directory": "packages/npm"
  },
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./gsx.d.ts",
      "default": "./gsx.js"
    },
    "./gsx.wasm": "./gsx.wasm",
    "./schema.json": "./gsx-1.schema.json"
  },
  "files": [
    "gsx.js",
    "gsx.d.ts",
    "gsx.wasm",
    "gsx-1.schema.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "error"
    }
  }
}
